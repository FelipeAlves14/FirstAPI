{
    "name": "FirstAPI",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "humao.rest-client"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    "postCreateCommand": "pip3 install -r requirements.txt",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Application",
            "onAutoForward": "notify"
        }
    }
}